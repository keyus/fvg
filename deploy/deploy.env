# ---------- AWS ----------
# 你的账号：037221304348，cli 已 aws login（当前是 root 凭据，见 deploy/README.md 安全提示）
# 你已开通新加坡区的 Lightsail，部署改到这里（域名/Route53 是全局的，不受影响）
AWS_REGION=ap-southeast-1
# 用 SSO 或非默认凭据时填 profile 名，否则留空（走 aws configure 的默认 profile）
AWS_PROFILE=

# ---------- Lightsail（当前采用的方案）----------
# 资源名前缀（实例、静态 IP、密钥、ECR 都用它命名）
INSTANCE_NAME=uilines
# 套餐（Lightsail「含公网 IPv4」的套餐才推荐，仅 IPv6 的无法挂静态 IP / 无法用 A 记录解析）：
#   nano_3_0   $5  0.5G内存 2核 20G盘
#   micro_3_0  $7  1.0G内存 2核 40G盘
#   small_3_0  $12 2.0G内存 2核 60G盘  ← 当前选择：网站 + OpenVPN 同机
#   （仅 IPv6 的 nano_ipv6_3_0 $3.5 / micro_ipv6_3_0 $5 —— 没有公网 IPv4，不选）
LS_BUNDLE=small_3_0
# 是否同时在同一台实例上装 OpenVPN（网站占 443，OpenVPN 走 1194/udp）
INSTALL_VPN=1
# 系统镜像：ubuntu_24_04（默认用户 ubuntu）或 amazon_linux_2023
LS_BLUEPRINT=ubuntu_24_04
# 可用区：留空自动（ap-east-1a）
LS_AZ=
# ---------- 服务器（EC2 方案才用，Lightsail 忽略）----------
# t4g.small（2 核 2G）够用：镜像在本机构建，服务器只负责运行
INSTANCE_TYPE=t4g.small
# arm64（配 t4g，便宜；与本机 M 芯片同架构，本机构建是原生速度）
INSTANCE_ARCH=arm64
# SSH 密钥对名：留空则用 uilines-deploy（脚本自动创建，私钥存到 deploy/keys/）
KEY_NAME=
# 允许 SSH 的网段：显式写你的家庭/办公出口 IP（183.223.133.201 是当前 ISP IP）。
# 注意：留空会自动探测，但**如果你正连着这台服务器的 VPN**，探测到的会是服务器自己的 IP，
# 脚本已加自锁保护（保留原白名单），不过还是建议显式写死更省事。
SSH_ALLOW_CIDR=183.223.133.201/32

# ---------- 域名 / HTTPS ----------
# 当前线上域名：只解析二级域名 test.uilines.com（主域名与 www 暂不解析）
DOMAIN=test.uilines.com
# 是否同时解析 www.<DOMAIN>（0 = 不解析，Caddy 也就不会申请它的证书）
CREATE_WWW=0
# 申请 Let's Encrypt 证书的邮箱（可改成你的常用邮箱，只会收到证书到期提醒）
ACME_EMAIL=admin@uilines.com
# 1 = 自动把 uilines.com 与 www.uilines.com 的 A 记录指向弹性 IP
CREATE_DNS=1

# ---------- 数据库（Lightsail 方案固定用同机容器，下面这段只有 EC2 方案用）----------
# rds   = 托管 RDS MySQL 8.4（推荐，私有网络，自动备份）
# local = 同机 MySQL 8.4 容器（省钱，适合演示）
DB_MODE=rds
DB_NAME=uilines
DB_USER=uilines
RDS_CLASS=db.t4g.micro
RDS_STORAGE=20
# 香港区 MySQL 8.4 + db.t4g.micro 支持 gp2/gp3/io1/io2，这里用 gp3
RDS_STORAGE_TYPE=gp3

# ---------- 镜像 ----------
# local = 本机构建（原生 arm64，快）→ 推 ECR → 服务器拉取（推荐）
# instance = 在服务器上构建（省 ECR，但吃内存、慢）
IMAGE_MODE=local
IMAGE_TAG=latest
ECR_REPO=uilines

# ---------- 应用 ----------
# 1 = 带上演示会员/订单（看数据用）；0 = 干净库（正式上线用）
SEED_DEMO_DATA=0
# 后台默认管理员（首次 seed 创建；登录后请立刻改密码）
ADMIN_EMAIL=admin@uilines.dev
# 会员日志的 IP 归属地外部查询：1 开启 / 0 关闭（无外网出口时设 0）
GEOIP_LOOKUP=0
# 后台「帮助与支持」展示的维护人联系方式
SUPPORT_EMAIL=admin@uilines.dev
SUPPORT_PHONE=
