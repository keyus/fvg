# 一键部署配置：复制成 deploy/deploy.env 后填写
#   cp deploy/deploy.env.example deploy/deploy.env
#
# 标注「必填」的需要你决定，其余保持默认即可。

# ---------- AWS ----------
# 必填：区域（东京离国内近；也可换成 us-west-2 / ap-southeast-1）
AWS_REGION=ap-northeast-1
# 用 SSO 或非默认凭据时填 profile 名，否则留空（走 aws configure 的默认 profile）
AWS_PROFILE=

# ---------- Lightsail（推荐的省钱方案）----------
# 套餐（只有「含公网 IPv4」的套餐能挂静态 IP / 用 A 记录解析域名）：
#   nano_3_0  $5  0.5G/2核/20G  ← 含 IPv4 里最便宜（靠 2G swap，偏慢）
#   micro_3_0 $7  1.0G/2核/40G  ← 推荐
#   small_3_0 $12 2.0G/2核/60G
#   auto = 自动挑含 IPv4 的最便宜 nano
LS_BUNDLE=micro_3_0
# 系统镜像：ubuntu_24_04（默认用户 ubuntu）或 amazon_linux_2023
LS_BLUEPRINT=ubuntu_24_04
# 可用区：留空自动
LS_AZ=

# ---------- 服务器（EC2 方案用；Lightsail 忽略）----------
# 资源名前缀（安全组、实例、RDS 都用它命名，避免和别的项目撞名）
INSTANCE_NAME=uilines
# t4g.medium（2 核 4G，构建镜像更稳）或 t4g.small（2G，便宜一半，已自动加 2G swap）
INSTANCE_TYPE=t4g.medium
# arm64（配 t4g，便宜）或 x86_64（配 t3/m5）
INSTANCE_ARCH=arm64
# SSH 密钥对名：留空则用 uilines-deploy（脚本自动创建，私钥存到 deploy/keys/）
KEY_NAME=
# 允许 SSH 的网段：留空自动取你当前公网 IP（/32）
SSH_ALLOW_CIDR=

# ---------- 域名 / HTTPS ----------
# 必填（有域名就填，例：shop.example.com），部署脚本会自动用 Caddy 申请证书。
# 留空 = 先用「弹性 IP + HTTP」跑通（仅测试；正式对外请尽快补域名）
DOMAIN=
# 申请 Let's Encrypt 证书的邮箱（填了 DOMAIN 就必填）
ACME_EMAIL=
# 1 = 自动在 Route53 把 DOMAIN 与 www.DOMAIN 的 A 记录指向弹性 IP（域名需在本账号）
CREATE_DNS=1

# ---------- 数据库 ----------
# rds   = 托管 RDS MySQL 8.4（推荐，私有网络，自动备份）
# local = 同机 MySQL 8.4 容器（省钱，适合演示）
DB_MODE=rds
DB_NAME=uilines
DB_USER=uilines
RDS_CLASS=db.t4g.micro
RDS_STORAGE=20
# 存储类型：多数区域用 gp3（香港区同样支持 gp2/gp3/io1/io2）
RDS_STORAGE_TYPE=gp3

# ---------- 镜像 ----------
# local = 本机构建（原生架构，快）→ 推 ECR → 服务器拉取（推荐，服务器可以很小）
# instance = 在服务器上构建（省 ECR，但吃内存、慢）
IMAGE_MODE=local
IMAGE_TAG=latest
ECR_REPO=uilines

# ---------- 应用 ----------
# 1 = 带上演示会员/订单（看数据用）；0 = 干净库（正式上线用）
SEED_DEMO_DATA=0
# 后台默认管理员（首次 seed 创建；登录后请立刻改密码）
ADMIN_EMAIL=admin@uilines.dev
# 会员日志的 IP 归属地外部查询：1 开启 / 0 关闭（无外网出口时设 0）
GEOIP_LOOKUP=0
# 后台「帮助与支持」展示的维护人联系方式
SUPPORT_EMAIL=admin@uilines.dev
SUPPORT_PHONE=
